---
import BrandMark from './ui/BrandMark.astro';
import GitHubIcon from './ui/GitHubIcon.astro';
import {navigation} from '../data/navigation';
---
<header class="site-header">
  <nav aria-label="主要导航" class="header-nav content-wide">
    <a href="/" class="header-brand"><BrandMark /></a>
    <div class="desktop-nav">
      {navigation.map(item => <a href={item.href} class="navigation-link" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.external && <GitHubIcon size="small" />}{item.label}</a>)}
    </div>
    <button id="menu-toggle" type="button" aria-label="菜单" aria-controls="mobile-menu" aria-expanded="false">
      <svg aria-hidden="true" class="menu-open-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      <svg aria-hidden="true" class="menu-close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden mobile-menu">
    <div class="mobile-links content-wide">
      {navigation.map(item => <a href={item.href} class="navigation-link" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.external && <GitHubIcon size="small" />}{item.label}</a>)}
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const navigationBar = header?.querySelector('nav');
  const updateHeaderHeight = () => { if (navigationBar) document.documentElement.style.setProperty('--header-height', `${navigationBar.getBoundingClientRect().height + 1}px`); };
  if (header) new ResizeObserver(updateHeaderHeight).observe(header);
  updateHeaderHeight();
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '关闭菜单' : '菜单');
    updateHeaderHeight();
  };
  toggle?.addEventListener('click', () =>
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true')
  );
  menu?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => setMenuOpen(false))
  );
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setMenuOpen(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', event => { if (event.matches) setMenuOpen(false); });
</script>
<style>
  .site-header { position: fixed; top: 0; width: 100%; z-index: 50; padding-inline: var(--space-4); background: color-mix(in srgb, var(--color-canvas) 80%, transparent); backdrop-filter: blur(24px); border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent); }
  .header-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-4); }
  .header-brand { display: inline-flex; align-items: center; min-width: 0; min-height: var(--control-size); max-width: calc(100% - var(--control-size) - var(--space-3)); }
  .desktop-nav { display: none; }
  #menu-toggle { flex-shrink: 0; width: var(--control-size); min-height: var(--control-size); padding: 8px; color: var(--color-muted); transition: color var(--motion-duration) var(--motion-ease); }
  #menu-toggle:hover { color: var(--color-ink); }
  #menu-toggle svg { width: 24px; height: 24px; }
  .menu-close-icon { display: none; }
  #menu-toggle[aria-expanded='true'] .menu-open-icon { display: none; }
  #menu-toggle[aria-expanded='true'] .menu-close-icon { display: block; }
  .mobile-menu { background: color-mix(in srgb, var(--color-canvas) 95%, transparent); }
  .mobile-links { display: flex; flex-direction: column; gap: var(--space-4); padding-block: var(--space-4); }
  @media (min-width: 768px) { .desktop-nav { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); } #menu-toggle, .mobile-menu { display: none; } }
</style>
