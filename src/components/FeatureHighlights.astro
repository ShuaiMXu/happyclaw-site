---
import SectionHeading from './ui/SectionHeading.astro';
const highlights = [
  { title: '复用原生能力', description: '直接使用 Claude Code 完整运行时，随着上游升级获得能力更新。' },
  { title: '从熟悉的入口发起任务', description: '飞书、Telegram 和 Web 共享消息路由、状态同步与格式适配。' },
  { title: '让每位用户保有独立边界', description: '工作区、通道、会话和记忆按用户隔离，多用户互不干扰。' },
];
---
<section id="features" class="site-section">
  <SectionHeading title="核心优势" description="把完整 Agent 运行时、多端接入和用户隔离放在同一套自托管系统里。" />
  <div class="content-wide grid gap-8 md:grid-cols-3">
    {highlights.map((item, index) => <div class="highlight"><span class="text-accent font-mono" aria-hidden="true">0{index + 1}</span><h3 class="group-title">{item.title}</h3><p>{item.description}</p></div>)}
  </div>
</section>
<style>
  .highlight { padding-left: var(--space-6); border-left: 1px solid var(--color-outline); }
  h3 { margin: var(--space-3) 0; }
  p { font-size: var(--type-caption); color: var(--color-muted); }
</style>
