---
interface Props { title: string; items: {title: string; description: string}[]; }
const {title, items} = Astro.props;
---
<div class="capability-group"><h3 class="group-title">{title}</h3><dl>{items.map(item => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}</dl></div>
<style>
  .capability-group { border-top: 2px solid var(--color-accent); padding-top: var(--space-6); min-width: 0; }
  h3 { margin-bottom: var(--space-6); }
  dl { display: grid; gap: var(--space-6); }
  dt { font-weight: 600; margin-bottom: var(--space-2); }
  dd { color: var(--color-muted); font-size: var(--type-caption); line-height: var(--line-body); }
</style>
