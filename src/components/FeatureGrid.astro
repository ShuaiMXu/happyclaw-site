---
import SectionHeading from './ui/SectionHeading.astro';
import CapabilityGroup from './ui/CapabilityGroup.astro';
import {capabilityGroups} from '../data/capabilities';
---
<section id="capabilities" class="site-section">
  <SectionHeading title="强大特性" description="按运行、接入和管理查看能力细节。" />
  <div class="content-wide grid gap-12 md:grid-cols-3">
    {capabilityGroups.map(group => <CapabilityGroup {...group} />)}
  </div>
</section>
