---
interface Props { id: string; title: string; command: string; }
const {id, title, command} = Astro.props;
---
<li class="command-step" data-command-step={id}>
  <div class="step-heading"><h3>{title}</h3><button type="button" class="button button-secondary" data-copy-command={command} aria-label={'复制' + title + '命令'} aria-describedby={'copy-status-' + id}>复制命令</button></div>
  <pre tabindex="0" role="region" aria-label={title + "命令，可横向滚动查看完整内容"}><code>{command}</code></pre>
  <div class="scroll-hint-row" data-scroll-hint-row hidden>
    <p class="scroll-hint" data-scroll-hint hidden>横向滚动查看完整命令。</p>
  </div>
  <p id={'copy-status-' + id} role="status" aria-live="polite" class="copy-status"></p>
</li>
<style>
  .command-step { padding: var(--space-4); background: var(--color-surface-deep); border: 1px solid var(--color-outline); border-radius: var(--radius-panel); min-width: 0; }
  .step-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
  h3 { flex: 1 1 10ch; min-width: 0; font-weight: 600; }
  button { flex-shrink: 0; max-width: 100%; font-size: var(--type-caption); padding-inline: var(--space-3); }
  pre { margin: 0; white-space: pre; overflow-x: auto; padding-block: var(--space-2); color: var(--color-accent); font-size: var(--type-caption); line-height: 1.7; }
  .scroll-hint-row { min-height: calc(var(--type-caption) * 1.7); margin-top: var(--space-2); }
  .scroll-hint { margin: 0; color: var(--color-muted); font-size: var(--type-caption); line-height: 1.7; }
  .copy-status { font-size: var(--type-caption); margin-top: var(--space-3); color: var(--color-success); }
  .copy-status:empty { margin-top: 0; }
  .copy-status[data-error] { color: var(--color-error); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-command-step]').forEach(step => {
    const pre = step.querySelector<HTMLPreElement>('pre');
    const hintRow = step.querySelector<HTMLElement>('[data-scroll-hint-row]');
    const hint = step.querySelector<HTMLElement>('[data-scroll-hint]');
    if (!pre || !hintRow || !hint) return;

    const updateScrollHint = () => {
      const hasOverflow = pre.scrollWidth > pre.clientWidth;
      const hasMoreContent = pre.scrollLeft + pre.clientWidth < pre.scrollWidth - 1;
      step.toggleAttribute('data-has-scroll-hint', hasOverflow);
      hintRow.hidden = !hasOverflow;
      hint.hidden = !hasMoreContent;
    };

    pre.addEventListener('scroll', updateScrollHint, {passive: true});
    window.addEventListener('resize', updateScrollHint);
    updateScrollHint();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach(button => {
    button.addEventListener('click', async () => {
      const status = document.getElementById(button.getAttribute('aria-describedby') || '');
      if (!status || button.disabled) return;
      status.removeAttribute('data-error'); status.textContent = '正在复制命令…';
      button.disabled = true; button.setAttribute('aria-busy', 'true');
      let timeout: number | undefined;
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await Promise.race([
          navigator.clipboard.writeText(button.dataset.copyCommand || ''),
          new Promise<void>((_, reject) => { timeout = window.setTimeout(() => reject(new Error('Copy result timeout')), 5000); }),
        ]);
        status.textContent = '命令已复制';
      } catch {
        status.setAttribute('data-error', ''); status.textContent = '暂未确认复制结果，请选中上方命令手动复制。';
      } finally { window.clearTimeout(timeout); button.disabled = false; button.removeAttribute('aria-busy'); }
    });
  });
</script>
