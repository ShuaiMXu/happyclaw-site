---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HappyClaw - 让 AI Agent 在你的团队里真正干活',
  description = '把 AI Agent 接进团队已有的飞书、Telegram 和 Web 工作流。在线试用 HappyClaw，或将开源平台私有化部署到自己的环境。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="HappyClaw, AI Agent, Claude Code, 飞书, Telegram, 自托管"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://happyclaw.cc/og-image.png" />
    <meta property="og:url" content="https://happyclaw.cc" />
    <meta property="og:type" content="website" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://happyclaw.cc/og-image.png" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-900 text-white font-sans antialiased">
    <slot />
  </body>
</html>
