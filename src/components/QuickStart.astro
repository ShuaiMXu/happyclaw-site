---
import SectionHeading from './ui/SectionHeading.astro';
import CommandStep from './ui/CommandStep.astro';
const steps = [
  {id: 'clone', title: '1. 克隆仓库', command: 'git clone https://github.com/riba2534/happyclaw.git'},
  {id: 'directory', title: '2. 进入目录', command: 'cd happyclaw'},
  {id: 'start', title: '3. 一键启动', command: 'make start'},
];
---
<section id="quickstart" class="site-section">
  <SectionHeading title="快速开始" description="准备好 Node.js >= 20 和 Docker，再按顺序运行三条命令。" />
  <ol class="content-reading grid gap-4">
    {steps.map(step => <CommandStep {...step} />)}
  </ol>
  <p class="text-center text-muted mt-6">启动后访问 <code class="text-accent">http://localhost:3000</code> 开始使用</p>
</section>
<style>
  code { overflow-wrap: anywhere; }
</style>
