---
interface Props { variant?: 'compact' | 'hero'; showName?: boolean; }
const {variant = 'compact', showName = true} = Astro.props;
---
<span class:list={['brand-mark', variant]}><img src="/logo.png" alt="" width="2048" height="2048" />{showName && <span class="brand-name">HappyClaw</span>}</span>
<style>
  .brand-mark { display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0; max-width: 100%; }
  img { width: 32px; height: 32px; flex-shrink: 0; border-radius: var(--radius-brand); }
  .brand-name { min-width: 0; white-space: nowrap; font-size: var(--type-brand); font-weight: 700; }
  .hero { margin-bottom: var(--space-8); }
  .hero img { width: 6rem; height: auto; max-width: 100%; border-radius: var(--radius-panel); box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25); }
  @media (min-width: 768px) { .hero img { width: 8rem; } }
</style>
