---
import SectionHeading from './ui/SectionHeading.astro';
import {architectureLayers} from '../data/architecture';
---
<section id="architecture" class="site-section">
  <SectionHeading title="技术架构" description="从消息入口到运行时与存储，查看系统各层的职责。" />
  <div class="content-wide">
    <svg viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" class="hidden lg:block w-full h-auto" role="img" aria-label="HappyClaw 技术架构图：接入层、主进程、执行层、运行时、存储层">
      <defs><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="var(--color-accent)" /></marker></defs>
      {architectureLayers.map((layer, index) => <g>
        <rect x="90" y={20 + index * 100} width="690" height="72" rx="12" fill="var(--color-surface)" stroke="var(--color-outline)" />
        <text x="78" y={62 + index * 100} text-anchor="end" fill="var(--color-accent)" font-size="14" font-weight="600">{layer.title}</text>
        {layer.nodes.map((node, column) => <g><rect x={108 + column * (654 / layer.nodes.length)} y={35 + index * 100} width={654 / layer.nodes.length - 12} height="42" rx="8" fill="var(--color-canvas)" /><text x={108 + column * (654 / layer.nodes.length) + (654 / layer.nodes.length - 12) / 2} y={61 + index * 100} text-anchor="middle" fill="var(--color-ink)" font-size="14">{node}</text></g>)}
        {index < architectureLayers.length - 1 && <line x1="435" y1={93 + index * 100} x2="435" y2={117 + index * 100} stroke="var(--color-accent)" stroke-width="1.5" marker-end="url(#arrowhead)" />}
      </g>)}
    </svg>
    <ol class="architecture-mobile lg:hidden" aria-label="技术架构各层">
      {architectureLayers.map(layer => <li><h3>{layer.title}</h3><ul>{layer.nodes.map(node => <li>{node}</li>)}</ul></li>)}
    </ol>
  </div>
</section>
<style>
  .architecture-mobile { display: grid; gap: var(--space-6); max-width: var(--content-reading); margin-inline: auto; }
  .architecture-mobile > li { background: var(--color-surface); border: 1px solid var(--color-outline); border-radius: var(--radius-panel); padding: var(--space-6); }
  h3 { color: var(--color-accent); font-weight: 600; margin-bottom: var(--space-3); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); color: var(--color-muted); font-size: var(--type-caption); }
  @media (min-width: 1024px) { .architecture-mobile { display: none; } }
</style>
