---
import SectionHeading from './ui/SectionHeading.astro';
import ScreenshotFigure from './ui/ScreenshotFigure.astro';
import {screenshots} from '../data/screenshots';
const channels = [
  {id: 'web', label: 'Web 界面', description: '在浏览器中查看工具调用、Markdown 回复和图片生成结果。'},
  {id: 'mobile', label: '移动端', description: '通过手机登录、查看群组、监控任务并调整设置。'},
  {id: 'feishu', label: '飞书集成', description: '在飞书中对话，并通过卡片查看回复。'},
] as const;
---
<section id="screenshots" class="site-section">
  <SectionHeading title="产品截图" description="查看实际界面；需要读取细节时，可以打开原图。" />
  <div role="tablist" aria-label="产品截图渠道" class="channel-tabs">
    {channels.map((channel, index) => <button type="button" id={'tab-' + channel.id} role="tab" data-tab={channel.id} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={'panel-' + channel.id} tabindex={index === 0 ? 0 : -1}>{channel.label}</button>)}
  </div>
  {channels.map((channel, index) => <div id={'panel-' + channel.id} data-panel={channel.id} role="tabpanel" aria-labelledby={'tab-' + channel.id} hidden={index !== 0} tabindex="0" class="content-wide">
    <p class="channel-description">{channel.description}</p>
    <div class:list={['shot-grid', channel.id]}>
      {screenshots[channel.id].map(shot => <ScreenshotFigure {...shot} />)}
    </div>
  </div>)}
</section>
<style>
  .channel-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); margin-bottom: var(--space-8); }
  [role='tab'] { min-height: 44px; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-outline); border-radius: var(--radius-control); color: var(--color-muted); background: transparent; font-size: var(--type-caption); transition: background-color var(--motion-duration) var(--motion-ease); }
  [role='tab']:hover { background: var(--color-surface); }
  [role='tab'][aria-selected='true'] { background: var(--color-action); color: var(--color-ink); border-color: var(--color-accent); font-weight: 600; }
  [hidden] { display: none; }
  .channel-description { color: var(--color-muted); margin-bottom: var(--space-6); }
  .shot-grid { display: grid; gap: var(--space-8); }
  .mobile { max-width: 20rem; margin-inline: auto; }
  @media (min-width: 768px) {
    .web { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .web :global(figure:first-child) { grid-column: 1 / -1; }
    .mobile { max-width: none; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .feishu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
<script>
  const tablist = document.querySelector<HTMLElement>('#screenshots [role="tablist"]');
  const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('[role="tab"]') || [])];
  const panels = document.querySelectorAll<HTMLElement>('#screenshots [role="tabpanel"]');
  function selectTab(tab: HTMLButtonElement, focus = false) {
    tabs.forEach(item => { const selected = item === tab; item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1; });
    panels.forEach(panel => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
    if (focus) tab.focus();
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault(); selectTab(tabs[next], true);
    });
  });
</script>
<noscript><p class="content-wide text-muted">启用 JavaScript 可切换渠道，也可以直接查看 <a class="text-accent underline" href="/screenshots/mobile-groups.png">移动端原图</a> 和 <a class="text-accent underline" href="/screenshots/feishu-chat.png">飞书原图</a>。</p></noscript>
