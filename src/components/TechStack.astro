---
import SectionHeading from './ui/SectionHeading.astro';
const techs = ['Node.js', 'TypeScript', 'React', 'Vite', 'Tailwind CSS', 'Docker', 'SQLite', 'Hono', 'Claude SDK', 'Zustand'];
---
<section id="technology" class="site-section">
  <SectionHeading title="技术栈" description="运行与界面采用的主要技术。" />
  <ul class="tech-list content-reading" aria-label="技术栈">{techs.map(tech => <li>{tech}</li>)}</ul>
</section>
<style>
  .tech-list { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  li { padding: var(--space-2) var(--space-4); border: 1px solid var(--color-outline); border-radius: var(--radius-control); color: var(--color-muted); font-size: var(--type-caption); }
</style>
